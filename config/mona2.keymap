#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "gesture/gesture_L7.dtsi"
#include "gesture/gesture_L8.dtsi"
#include "gesture/gesture_L9.dtsi"

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/* --- レイヤー番号の定義 ---
 * LY_プレフィックスでdevicetreeのブロック名との衝突を回避
 */

#define LY_DEF       0
#define LY_US_D      1
#define LY_IPAD      2
#define LY_ARR_US    3
#define LY_ARR_JIS   4
#define LY_NUM_US    5
#define LY_MOUSE     6
#define LY_SCR       7
#define LY_SYS       8
#define LY_US_M      9
#define LY_JIS_M     10
#define LY_GEST_L9   11
#define LY_NUMJIS    12
#define LY_IPAD_ACT  13

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&sl { release-after-ms = <250>; };

/ {
    combos {
        compatible = "zmk,combos";

        Gesture_L8 {
            bindings = <&kp DELETE>;
            key-positions = <9 8>;
        };

        Gesture_L9 {
            bindings = <&lt 11 LEFT_WIN>;
            key-positions = <19 20>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
        };

        combo_del {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        /* J+K -> LANGUAGE_1 / K+L -> LANGUAGE_2
         * 土台レイヤー(0=JIS, 1=US, 2=iPad)でのみ有効(MOUSEなど上のレイヤーでは無効) */

        combo_lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 18>;
            layers = <0 1 2>;
        };

        combo_lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <18 19>;
            layers = <0 1 2>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mul_mark: x_sign_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N5>,
                <&macro_release>,
                <&kp LALT>;
        };

        div_mark: div_mark {
            compatible = "zmk,behavior-macro";
            label = "DIV_MARK";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N7>,
                <&macro_release>,
                <&kp LALT>;
        };

        to_layer_0_mkp: to_layer_0_mkp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &mkp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0_MKP";
        };

        macro_s: macro_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp H &kp O &kp N &kp N &kp A &kp D &kp A &kp I>;
            label = "MACRO_S";
        };

        macro_d: macro_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LS(A) &kp N2 &kp N9 &kp N5 &kp X &kp P>;
            label = "MACRO_D";
        };

        bt0_jis: bt0_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 0 &to 1>;
            label = "BT0_JIS";
        };

        bt1_us: bt1_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "BT1_US";
        };

        bt2_us: bt2_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT2_US";
        };

        bt3_us: bt3_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "BT3_US";
        };

        bt4_ipad: bt4_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 4 &to 2>;
            label = "BT4_IPAD";
        };

        ipad_home: ipad_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp H>,
                <&macro_release>,
                <&kp GLOBE>;
            label = "IPAD_HOME";
        };

        ipad_full: ipad_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp F>,
                <&macro_release>,
                <&kp GLOBE>;
            label = "IPAD_FULL";
        };

        ipad_recent: ipad_recent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp UP>,
                <&macro_release>,
                <&kp GLOBE>;
            label = "IPAD_RECENT";
        };

        ipad_dock: ipad_dock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp GLOBE>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp GLOBE>;
            label = "IPAD_DOCK";
        };

        ipad_applib: ipad_applib {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LSHIFT>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp GLOBE &kp LSHIFT>;
            label = "IPAD_APPLIB";
        };

        ipad_left: ipad_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;
            label = "IPAD_LEFT";
        };

        ipad_right: ipad_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp GLOBE>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;
            label = "IPAD_RIGHT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to_layer_0>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <40>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <40>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };

        page_encoder: page_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(PAGE_DOWN)>, <&kp LC(PAGE_UP)>;
        };

        fusion_orbit: fusion_orbit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHIFT &mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LSHIFT &mkp MB3>;

            label = "FUSION_ORBIT";
        };

        pass: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS &kp H &kp H &kp Q &kp W &kp N9 &kp H>;
            label = "NEW_MACRO";
        };

        admini: admini {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp D &kp M &kp I &kp N &kp I &kp S &kp T &kp R &kp A &kp T &kp O &kp R>;
            label = "ADMINI";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* [0] DEFAULT (JIS OS用) */

        default_layer {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R                      &kp T                                              &kp Y        &kp U  &kp I      &kp O    &lt 7 P
&kp A                    &kp S         &kp D         &kp F                      &kp G                               &lt 8 ESC      &kp H        &kp J  &kp K      &kp L    &mt RIGHT_CONTROL MINUS
&mt LEFT_SHIFT Z         &kp X         &kp C         &kp V                      &kp B         &mt LEFT_SHIFT TAB    &kp DELETE     &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&mt LEFT_WIN LANGUAGE_2  &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_CONTROL LEFT_ALT  &lt 12 SPACE  &lt 10 TAB             &kp BACKSPACE  &lt 4 ENTER                             &mt RIGHT_ALT LANGUAGE_1
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [1] US_DEFO */

        us_defo {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R                    &kp T                                             &kp Y        &kp U  &kp I      &kp O    &lt 7 P
&mt LEFT_CONTROL A       &kp S         &kp D         &kp F                    &kp G                              &lt 8 ESC      &kp H        &kp J  &kp K      &kp L    &mt RIGHT_CONTROL MINUS
&mt LEFT_SHIFT Z         &kp X         &kp C         &kp V                    &kp B        &mt LEFT_SHIFT TAB    &kp DEL        &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&mt LEFT_GUI LANGUAGE_1  &kp LEFT_WIN  &kp LEFT_WIN  &mt LEFT_SHIFT LEFT_ALT  &lt 5 SPACE  &lt 9 TAB             &kp BACKSPACE  &lt 3 ENTER                             &mt RIGHT_ALT LANGUAGE_2
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [2] IPAD_BASE (iPad用US配列: Ctrl位置をCmdに / 「-」長押しでiPad操作レイヤー[13]) */

        ipad_base {
            bindings = <
&kp Q                    &kp W         &kp E         &kp R                    &kp T                                             &kp Y        &kp U  &kp I      &kp O    &lt 7 P
&mt LEFT_GUI A           &kp S         &kp D         &kp F                    &kp G                              &lt 8 ESC      &kp H        &kp J  &kp K      &kp L    &lt 13 MINUS
&mt LEFT_SHIFT Z         &kp X         &kp C         &kp V                    &kp B        &mt LEFT_SHIFT TAB    &kp DEL        &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&mt LEFT_GUI LANGUAGE_1  &kp LEFT_WIN  &kp LEFT_WIN  &mt LEFT_SHIFT LEFT_ALT  &lt 5 SPACE  &lt 9 TAB             &kp BACKSPACE  &lt 3 ENTER                             &mt RIGHT_ALT LANGUAGE_2
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [3] ARROW_US (Windows US設定用) */

        ARROW_US {
            bindings = <
&kp SLASH     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                     &kp RS(RG(LEFT))  &kp F2    &kp UP    &kp F4     &kp RS(RG(RIGHT))
&kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS             &kp F13  &kp LANGUAGE_2    &kp LEFT  &kp DOWN  &kp RIGHT  &kp LANGUAGE_1
&trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans     &trans    &trans   &trans            &kp F7    &trans    &kp F8     &kp F11
&trans        &kp NUMBER_0  &kp N0        &kp NUMBER_0  &lt 8 NUMBER_0  &trans    &trans   &trans                                           &kp F12
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [4] ARROW_JIS (Windows JIS設定用 - ARROW_USと同じ文字が出るよう変換) */

        ARROW_JIS {
            bindings = <
&kp SLASH    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                        &kp RS(RG(LEFT))  &kp F2    &kp UP    &kp F4     &kp RS(RG(RIGHT))
&kp LS(SQT)  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(SEMI)            &kp F13  &kp RA(LEFT)      &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans    &trans   &trans            &kp F7    &trans    &kp F8     &kp F11
&trans       &kp NUMBER_0  &kp NUMBER_0  &kp NUMBER_0  &to 8         &trans    &trans  &trans                                           &kp F12
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [5] NUM_US */

        NUM_US {
            bindings = <
&kp LS(N1)      &kp LS(N2)      &kp LS(N3)      &kp LS(N4)      &kp LS(N5)      &kp SLASH       &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9    &kp MINUS
&kp COLON       &kp LS(N7)      &kp LS(N9)      &kp LS(N0)      &kp EQUAL       &trans          &kp ASTERISK    &kp NUMBER_4    &kp NUMBER_5    &kp NUMBER_6    &kp PLUS
&kp DOUBLE_QUOTES  &kp APOSTROPHE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp ASTERISK    &kp SEMICOLON   &trans          &kp PERIOD      &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &kp ENTER
&trans        &trans    &trans        &kp NUMBER_0  &trans        &trans    &trans  &kp N0                                                  &kp PERIOD
            >;

            sensor-bindings = <&page_encoder>;
        };

        /* [6] MOUSE (オートマウスロイヤー・翗状維�) */

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        /* [7] SCROLL */

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        /* [8] SYSTEM */

        SYSTEM {
            bindings = <
&bt0_jis    &bt1_us         &bt2_us   &bt3_us   &bt4_ipad                       &trans  &trans  &trans  &trans  &trans
&trans      &macro_s        &macro_d  &macro_s  &trans             &trans       &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_CLR_ALL  &kp N2    &kp N3    &trans   &trans    &bootloader  &trans  &trans  &trans  &trans  &trans
&trans      &trans          &trans    &trans    &trans   &trans    &trans       &trans                          &trans
            >;
        };

        /* [9] US_MAP */

        US_MAP {
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                    &kp LS(N6)         &kp LS(N7)     &kp LS(NUMBER_9)  &kp LS(NUMBER_0)   &kp EQUAL
&kp TILDE   &trans      &macro_s    &macro_d    &kp SLASH             &trans  &kp APOSTROPHE     &kp COLON      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LS(MINUS)
&kp GRAVE   &trans      &trans      &trans      &trans      &trans    &trans  &kp DOUBLE_QUOTES  &kp SEMICOLON  &kp LS(COMMA)     &kp LS(DOT)        &kp LS(SLASH)
&trans      &trans      &trans      &trans      &trans      &trans    &trans  &trans                                                                 &trans
            >;
        };

        /* [10] JIS_MAP (US_MAPと同じ文字が出るようにJIS設驚用に変換) */

        JIS_MAP {
            bindings = <
&kp LS(N1)     &kp LBKT  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                    &kp LS(N6)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)   &kp LS(MINUS)
&kp LS(EQUAL)  &trans    &macro_s    &macro_d    &kp SLASH             &trans  &kp LS(N7)  &kp SQT     &kp RBKT       &kp BSLH     &kp LS(INT1)
&kp LS(LBKT)   &trans    &trans      &trans      &trans      &trans    &trans  &kp LS(N2)  &kp SEMI    &kp LS(COMMA)  &kp LS(DOT)  &kp LS(SLASH)
&trans         &trans    &trans      &trans      &trans      &trans    &trans  &trans                                              &trans
            >;
        };

        /* [11] Gesture_L9 */

        Gesture_L9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        /* [12] NUMJIS */

        NUMJIS {
            bindings = <
&kp LS(N1)      &kp LBKT        &kp LS(N3)      &kp LS(N4)      &kp LS(N5)      &kp SLASH       &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9    &kp MINUS
&kp SQT         &kp LS(N6)      &kp LS(N8)      &kp LS(N9)      &kp LS(MINUS)   &trans          &kp RS(SQT)     &kp NUMBER_4    &kp NUMBER_5    &kp NUMBER_6    &kp RS(SEMICOLON)
&kp LS(N2)      &kp LS(N7)      &kp RBKT        &kp BSLH        &kp RS(SQT)     &kp SEMI        &trans          &kp PERIOD      &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &kp ENTER
&trans        &trans    &trans        &kp NUMBER_0  &trans        &trans    &trans  &kp NUMBER_0                                            &kp PERIOD
            >;

            sensor-bindings = <&page_encoder>;
        };

        /* [13] IPAD_ACT (右手だけでウィンドウ/アプリ操作 / 「-」長押しの間だけ有効)
         * Y 前のアプリ  U 最近の一覧  I 全画面  O Dock
         * H ホーム  J 左半分  K 最小化  L 右半分
         * N 検索  , App Library  . 閉じる
         */

        ipad_act {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LG(TAB)    &ipad_recent  &ipad_full  &ipad_dock   &trans
&trans  &trans  &trans  &trans  &trans            &trans  &ipad_home     &ipad_left    &kp LG(M)   &ipad_right  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(SPACE)  &trans        &ipad_applib &kp LG(W)   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
